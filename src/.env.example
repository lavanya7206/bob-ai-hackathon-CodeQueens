# index fil<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ChainGuard AI — Supply Chain Intelligence</title>
  <link rel="stylesheet" href="styles.css" />
</head>
<body>

  <aside class="sidebar" id="sidebar">
    <div class="sidebar-logo">
      <span class="logo-icon">⬡</span>
      <span class="logo-text">ChainGuard <strong>AI</strong></span>
    </div>
    <nav class="sidebar-nav">
      <a href="#" class="nav-item active" data-section="overview">
        <span class="nav-icon">▦</span>
        <span class="nav-label">Overview</span>
      </a>
      <a href="#" class="nav-item" data-section="disruptions">
        <span class="nav-icon">⚡</span>
        <span class="nav-label">Disruption Monitor</span>
        <span class="nav-badge danger" id="badge-disruptions">5</span>
      </a>
      <a href="#" class="nav-item" data-section="shipments">
        <span class="nav-icon">📦</span>
        <span class="nav-label">Shipment Risk</span>
        <span class="nav-badge warning" id="badge-shipments">3</span>
      </a>
      <a href="#" class="nav-item" data-section="fleet">
        <span class="nav-icon">🚛</span>
        <span class="nav-label">Fleet Intelligence</span>
        <span class="nav-badge" id="badge-fleet">6</span>
      </a>
      <a href="#" class="nav-item" data-section="coldchain">
        <span class="nav-icon">❄</span>
        <span class="nav-label">Cold-Chain Monitor</span>
        <span class="nav-badge danger" id="badge-coldchain">2</span>
      </a>
      <a href="#" class="nav-item" data-section="assistant">
        <span class="nav-icon">✦</span>
        <span class="nav-label">AI Assistant</span>
      </a>
    </nav>
    <div class="sidebar-footer">
      <div class="system-status">
        <span class="status-dot"></span>
        <span>System Live</span>
      </div>
    </div>
  </aside>

  <div class="main-wrapper">

    <header class="app-header">
      <button class="hamburger" id="hamburger">☰</button>
      <div class="header-title">
        <h1>ChainGuard AI — Supply Chain Intelligence</h1>
        <span id="live-clock"></span>
      </div>
      <div class="header-actions">
        <button class="nh48-btn" id="nh48-btn" onclick="simulateNH48Closure()">
          🚧 Simulate NH-48 Disruption
        </button>
      </div>
    </header>

    <main class="main-content">

      <!-- OVERVIEW -->
      <section id="section-overview" class="section active">
        <div class="section-header">
          <h2>Operations Overview</h2>
        </div>
        <div class="kpi-grid" id="kpi-grid"></div>
        <div class="overview-bottom">
          <div class="card">
            <div class="card-header">
              <h3>Recent Alerts</h3>
              <span class="live-badge">● LIVE</span>
            </div>
            <ul class="alert-list" id="alert-list"></ul>
          </div>
          <div class="card">
            <div class="card-header"><h3>Active Disruptions Summary</h3></div>
            <div id="disruption-summary"></div>
          </div>
        </div>
      </section>

      <!-- DISRUPTION MONITOR -->
      <section id="section-disruptions" class="section">
        <div class="section-header">
          <h2>Disruption Monitor</h2>
          <span class="section-meta">Click a disruption to see affected shipments</span>
        </div>
        <div id="disruption-list"></div>
      </section>

      <!-- SHIPMENT RISK -->
      <section id="section-shipments" class="section">
        <div class="section-header">
          <h2>Shipment Risk Analysis</h2>
          <span class="section-meta">Scored 0–100 · Click any shipment to expand</span>
        </div>
        <div class="filter-bar">
          <button class="filter-btn active" data-filter="all">All</button>
          <button class="filter-btn" data-filter="disrupted">Disrupted</button>
          <button class="filter-btn" data-filter="at-risk">At Risk</button>
          <button class="filter-btn" data-filter="on-time">On Time</button>
          <button class="filter-btn" data-filter="rerouted">Rerouted</button>
        </div>
        <div class="shipment-list" id="shipment-list"></div>
      </section>

      <!-- FLEET INTELLIGENCE -->
      <section id="section-fleet" class="section">
        <div class="section-header">
          <h2>Fleet Intelligence</h2>
          <span class="section-meta">Idle assets available for redeployment</span>
        </div>
        <div class="fleet-layout">
          <div>
            <div class="card">
              <div class="card-header"><h3>Redeployment Opportunities</h3></div>
              <div id="redeployment-list"></div>
            </div>
          </div>
          <div>
            <div class="card">
              <div class="card-header"><h3>All Fleet Assets</h3></div>
              <div id="vehicle-list"></div>
            </div>
          </div>
        </div>
      </section>

      <!-- COLD-CHAIN MONITOR -->
      <section id="section-coldchain" class="section">
        <div class="section-header">
          <h2>Cold-Chain Temperature Monitor</h2>
        </div>
        <div id="excursion-banner"></div>
        <div id="coldchain-list"></div>
      </section>

      <!-- AI ASSISTANT -->
      <section id="section-assistant" class="section">
        <div class="section-header">
          <h2>AI Assistant</h2>
          <span class="section-meta">Context-aware supply chain intelligence</span>
        </div>
        <div class="assistant-layout">
          <div class="assistant-left">
            <div class="card situation-summary-card" id="situation-summary"></div>
            <div class="card chat-card">
              <div class="card-header">
                <h3>✦ ChainGuard AI</h3>
                <span class="live-badge">● ONLINE</span>
              </div>
              <div class="chat-messages" id="chat-messages"></div>
              <div class="quick-actions" id="quick-actions"></div>
              <div class="chat-input-row">
                <input type="text" class="chat-input" id="chat-input" placeholder="Ask about shipments, disruptions, fleet…" autocomplete="off" />
                <button class="btn btn-blue chat-send" id="chat-send">Send</button>
              </div>
            </div>
          </div>
          <div class="assistant-right">
            <div class="card">
              <div class="card-header"><h3>Suggested Actions</h3></div>
              <div id="suggested-actions-list"></div>
            </div>
            <div class="card" style="margin-top:0">
              <div class="card-header"><h3>Recent Activity</h3></div>
              <div id="ai-activity-log"></div>
            </div>
          </div>
        </div>
      </section>

    </main>
  </div>

  <!-- NH48 DISRUPTION MODAL -->
  <div class="modal-overlay hidden" id="nh48-modal">
    <div class="modal-box">
      <div class="modal-alert-bar">🚨 CRITICAL DISRUPTION DETECTED</div>
      <div class="modal-body">
        <h2>🚧 NH Route 48 — Road Closure</h2>
        <p class="modal-sub">Waterville Valley, New Hampshire · Reported just now</p>

        <div class="modal-stats">
          <div class="modal-stat red">
            <div class="modal-stat-val">3</div>
            <div class="modal-stat-lbl">Shipments Affected</div>
          </div>
          <div class="modal-stat amber">
            <div class="modal-stat-val">89</div>
            <div class="modal-stat-lbl">Peak Risk Score</div>
          </div>
          <div class="modal-stat blue">
            <div class="modal-stat-val">2</div>
            <div class="modal-stat-lbl">Fleet Assets Ready</div>
          </div>
          <div class="modal-stat green">
            <div class="modal-stat-val">$18.4K</div>
            <div class="modal-stat-lbl">Recovery Value</div>
          </div>
        </div>

        <div class="modal-section">
          <div class="modal-section-title">📦 Affected Shipments</div>
          <div class="modal-row"><span class="mbadge red">DISRUPTED</span><span><strong>SHP-NH01</strong> — Boston → Burlington · Medical Supplies · Risk: 89/100</span></div>
          <div class="modal-row"><span class="mbadge amber">AT-RISK</span><span><strong>SHP-NH02</strong> — Portland ME → Albany NY · Auto Parts (Cold) · Risk: 73/100</span></div>
          <div class="modal-row"><span class="mbadge amber">AT-RISK</span><span><strong>SHP-NH03</strong> — Manchester NH → Montreal · Retail Goods · Risk: 56/100</span></div>
        </div>

        <div class="modal-section">
          <div class="modal-section-title">✦ Recommended Alternate Routes</div>
          <div class="modal-row"><span class="mbadge blue">SHP-NH01</span><span>I-93 N → I-89 N → VT-2 W · Saves 3.5h · 92% confidence</span></div>
          <div class="modal-row"><span class="mbadge blue">SHP-NH02</span><span>US-302 W → I-91 N → I-90 W · Cold-chain maintained · 88% confidence</span></div>
          <div class="modal-row"><span class="mbadge blue">SHP-NH03</span><span>I-93 N → US-3 N → QC-35 N · Near-zero delay · 95% confidence</span></div>
        </div>

        <div class="modal-section">
          <div class="modal-section-title">🚛 Idle Fleet Ready for Redeployment</div>
          <div class="modal-row"><span class="mbadge green">IDLE</span><span><strong>TRK-013</strong> — Heavy Truck · Concord, NH · 12 miles from closure</span></div>
          <div class="modal-row"><span class="mbadge green">IDLE</span><span><strong>TRK-014</strong> — Cargo Van · White River Jct, VT · At alternate route endpoint</span></div>
        </div>

        <div class="modal-actions">
          <button class="modal-btn primary" onclick="closeModal(); navigateTo('shipments')">View Affected Shipments</button>
          <button class="modal-btn secondary" onclick="closeModal(); navigateTo('fleet')">Deploy Fleet</button>
          <button class="modal-btn secondary" onclick="closeModal(); navigateTo('disruptions')">View Disruptions</button>
          <button class="modal-btn ghost" onclick="closeModal()">Dismiss</button>
        </div>
      </div>
    </div>
  </div>

  <!-- HELP MODAL -->
  <div class="modal-overlay hidden" id="help-modal">
    <div class="modal-box" style="border-color:rgba(59,130,246,.4);max-width:560px">
      <div class="modal-alert-bar" style="background:var(--blue)">? DEMO GUIDE — ChainGuard AI</div>
      <div class="modal-body">
        <h2 style="font-size:16px;margin-bottom:12px">How to Demo ChainGuard AI</h2>
        <div class="help-steps">
          <div class="help-step"><span class="help-num">1</span><div><strong>Overview</strong> — Start here. Show the 6 KPI cards and live alerts feed. Point out the On-Time Rate drop and active excursions.</div></div>
          <div class="help-step"><span class="help-num">2</span><div><strong>Disruption Monitor</strong> — Click each disruption card to expand. Show recommended actions and click a shipment tag to deep-link.</div></div>
          <div class="help-step"><span class="help-num">3</span><div><strong>Shipment Risk</strong> — Show the risk score breakdown for SHP-4821 and SHP-5512. Accept a reroute to demonstrate the state change.</div></div>
          <div class="help-step"><span class="help-num">4</span><div><strong>Fleet Intelligence</strong> — Show idle vehicles highlighted. Click Assign to deploy TRK-001 to cover SHP-5512.</div></div>
          <div class="help-step"><span class="help-num">5</span><div><strong>Cold-Chain Monitor</strong> — Show the temperature excursion charts. Click "Log Corrective Action" multiple times.</div></div>
          <div class="help-step"><span class="help-num">6</span><div><strong>AI Assistant</strong> — Click quick-action buttons. Ask "situation report" for the full summary.</div></div>
          <div class="help-step help-step-highlight"><span class="help-num">★</span><div><strong>Simulate NH-48 Disruption</strong> — Click the red button in the header at any point. This is the showstopper moment — watch everything update live.</div></div>
        </div>
        <div class="modal-actions" style="margin-top:16px">
          <button class="modal-btn primary" onclick="document.getElementById('help-modal').classList.add('hidden')">Got it — Start Demo</button>
        </div>
      </div>
    </div>
  </div>

  <!-- HELP BUTTON -->
  <button class="help-fab" onclick="document.getElementById('help-modal').classList.remove('hidden')" title="Demo Guide">?</button>

  <script src="app.js"></script>
</body>
</html>


# STYLE/* ═══════════════════════════════════════════════════════════════
   ChainGuard AI — Styles
   ═══════════════════════════════════════════════════════════════ */

:root {
  --bg:         #0d1117;
  --bg2:        #161b22;
  --bg3:        #1c2128;
  --bg3h:       #22272e;
  --border:     #30363d;
  --border2:    #21262d;
  --text:       #e6edf3;
  --text2:      #8b949e;
  --text3:      #484f58;
  --blue:       #3b82f6;
  --blue2:      #1d4ed8;
  --green:      #22c55e;
  --amber:      #f59e0b;
  --orange:     #f97316;
  --red:        #ef4444;
  --purple:     #a855f7;
  --teal:       #14b8a6;
  --sidebar:    240px;
  --header:     58px;
  --r:          8px;
  --r2:         4px;
  --t:          0.18s ease;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html, body {
  height: 100%;
  font-family: -apple-system, "Segoe UI", system-ui, sans-serif;
  font-size: 14px;
  line-height: 1.6;
  background: var(--bg);
  color: var(--text);
  overflow: hidden;
}

a { color: inherit; text-decoration: none; }
button { cursor: pointer; font-family: inherit; }
ul { list-style: none; }

/* ── Layout ───────────────────────────────────────────────────── */
body { display: flex; height: 100vh; }

.sidebar {
  width: var(--sidebar);
  min-width: var(--sidebar);
  height: 100vh;
  background: var(--bg2);
  border-right: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  position: fixed;
  left: 0; top: 0;
  z-index: 100;
  transition: transform var(--t);
}

.sidebar-logo {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 18px 20px 16px;
  border-bottom: 1px solid var(--border);
}

.logo-icon { font-size: 22px; color: var(--blue); }
.logo-text  { font-size: 16px; }
.logo-text strong { color: var(--blue); }

.sidebar-nav { flex: 1; padding: 10px 0; overflow-y: auto; }

.nav-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 20px;
  color: var(--text2);
  border-left: 3px solid transparent;
  font-size: 13.5px;
  transition: background var(--t), color var(--t);
}

.nav-item:hover  { background: var(--bg3); color: var(--text); }
.nav-item.active { background: rgba(59,130,246,.1); color: var(--blue); border-left-color: var(--blue); }

.nav-icon  { font-size: 15px; width: 18px; text-align: center; }
.nav-label { flex: 1; }

.nav-badge {
  font-size: 10px; font-weight: 700;
  padding: 1px 6px; border-radius: 10px;
  background: var(--blue); color: #fff;
  min-width: 18px; text-align: center;
}
.nav-badge.warning { background: var(--amber); color: #000; }
.nav-badge.danger  { background: var(--red); }

.sidebar-footer {
  padding: 14px 20px;
  border-top: 1px solid var(--border);
}

.system-status {
  display: flex; align-items: center; gap: 8px;
  font-size: 12px; color: var(--text2);
}

.status-dot {
  width: 8px; height: 8px;
  border-radius: 50%;
  background: var(--green);
}

.main-wrapper {
  margin-left: var(--sidebar);
  flex: 1;
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
}

/* ── Header ───────────────────────────────────────────────────── */
.app-header {
  height: var(--header);
  background: var(--bg2);
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 0 24px;
  flex-shrink: 0;
}

.hamburger {
  display: none;
  background: none; border: none;
  color: var(--text2); font-size: 20px;
}

.header-title { flex: 1; }
.header-title h1  { font-size: 15px; font-weight: 600; }
.header-title span { font-size: 12px; color: var(--text2); }

/* ── NH48 button ─────────────────────────────────────────────── */
.nh48-btn {
  padding: 9px 20px;
  background: linear-gradient(135deg, #dc2626, #b91c1c);
  color: #fff;
  border: none;
  border-radius: var(--r2);
  font-size: 13.5px;
  font-weight: 700;
  letter-spacing: .2px;
  white-space: nowrap;
  box-shadow: 0 0 0 3px rgba(220,38,38,.25);
  animation: nh48pulse 2s infinite;
  transition: transform var(--t);
}
.nh48-btn:hover { transform: translateY(-1px); }
.nh48-btn.fired {
  background: rgba(245,158,11,.2);
  color: var(--amber);
  border: 1px solid rgba(245,158,11,.4);
  box-shadow: none;
  animation: none;
}

@keyframes nh48pulse {
  0%,100% { box-shadow: 0 0 0 3px rgba(220,38,38,.25); }
  50%      { box-shadow: 0 0 0 7px rgba(220,38,38,0); }
}

/* ── Main content ─────────────────────────────────────────────── */
.main-content {
  flex: 1;
  overflow-y: auto;
  padding: 24px;
  background: var(--bg);
}

/* .section show/hide is handled by the fade rules below */

.section-header {
  display: flex; align-items: baseline; gap: 12px;
  margin-bottom: 20px;
}
.section-header h2  { font-size: 18px; font-weight: 600; }
.section-meta       { font-size: 12px; color: var(--text2); }

/* ── Cards ────────────────────────────────────────────────────── */
.card {
  background: var(--bg3);
  border: 1px solid var(--border);
  border-radius: var(--r);
  padding: 16px;
  margin-bottom: 16px;
}

.card-header {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 14px;
}
.card-header h3 { font-size: 13.5px; font-weight: 600; }

/* ── Badges ───────────────────────────────────────────────────── */
.badge {
  display: inline-block;
  font-size: 10px; font-weight: 700;
  padding: 2px 8px; border-radius: 10px;
  text-transform: uppercase; letter-spacing: .4px;
}
.b-green  { background: rgba(34,197,94,.15);  color: var(--green); }
.b-amber  { background: rgba(245,158,11,.15); color: var(--amber); }
.b-orange { background: rgba(249,115,22,.15); color: var(--orange); }
.b-red    { background: rgba(239,68,68,.15);  color: var(--red); }
.b-blue   { background: rgba(59,130,246,.15); color: var(--blue); }
.b-purple { background: rgba(168,85,247,.15); color: var(--purple); }
.b-teal   { background: rgba(20,184,166,.15); color: var(--teal); }

/* ── Buttons ─────────────────────────────────────────────────── */
.btn {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 7px 14px; border-radius: var(--r2);
  border: 1px solid transparent;
  font-size: 13px; font-weight: 500;
  transition: all var(--t);
}
.btn-success {
  background: rgba(34,197,94,.12); color: var(--green);
  border-color: rgba(34,197,94,.35);
}
.btn-success:hover { background: rgba(34,197,94,.22); }
.btn-blue {
  background: rgba(59,130,246,.12); color: var(--blue);
  border-color: rgba(59,130,246,.35);
}
.btn-blue:hover { background: rgba(59,130,246,.22); }

/* ── Live badge ──────────────────────────────────────────────── */
.live-badge {
  font-size: 11px; color: var(--green); font-weight: 600;
  animation: blink 1.5s infinite;
}
@keyframes blink { 0%,100%{opacity:1} 50%{opacity:.4} }

/* ── KPI Grid ─────────────────────────────────────────────────── */
.kpi-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  gap: 14px;
  margin-bottom: 20px;
}

.kpi-card {
  background: var(--bg3);
  border: 1px solid var(--border);
  border-left: 3px solid var(--blue);
  border-radius: var(--r);
  padding: 16px;
}
.kpi-card.red    { border-left-color: var(--red); }
.kpi-card.green  { border-left-color: var(--green); }
.kpi-card.amber  { border-left-color: var(--amber); }
.kpi-card.purple { border-left-color: var(--purple); }
.kpi-card.teal   { border-left-color: var(--teal); }

.kpi-value { font-size: 30px; font-weight: 700; line-height: 1.1; }
.kpi-label { font-size: 12px; color: var(--text2); margin-top: 4px; }
.kpi-delta { font-size: 11px; font-weight: 600; margin-top: 5px; }
.kpi-delta.up   { color: var(--red); }
.kpi-delta.down { color: var(--green); }
.kpi-delta.flat { color: var(--text2); }

/* ── Overview bottom ─────────────────────────────────────────── */
.overview-bottom {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}

/* ── Alert list ──────────────────────────────────────────────── */
.alert-item {
  display: flex; align-items: flex-start; gap: 10px;
  padding: 9px 0;
  border-bottom: 1px solid var(--border2);
  font-size: 13px;
}
.alert-item:last-child { border-bottom: none; }
.alert-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; margin-top: 5px; }
.alert-dot.red   { background: var(--red); }
.alert-dot.amber { background: var(--amber); }
.alert-dot.green { background: var(--green); }
.alert-dot.blue  { background: var(--blue); }
.alert-text { flex: 1; }
.alert-time { font-size: 11px; color: var(--text3); white-space: nowrap; }

/* ── Disruption summary ──────────────────────────────────────── */
.dis-summary-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 8px 0;
  border-bottom: 1px solid var(--border2);
  font-size: 13px;
}
.dis-summary-row:last-child { border-bottom: none; }

/* ── Disruption list ─────────────────────────────────────────── */
.disruption-card {
  background: var(--bg3);
  border: 1px solid var(--border);
  border-radius: var(--r);
  padding: 16px;
  margin-bottom: 12px;
  cursor: pointer;
  transition: border-color var(--t), background var(--t);
}
.disruption-card:hover { border-color: var(--blue); background: var(--bg3h); }
.disruption-card.expanded { border-color: var(--blue); }

.dis-header {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 6px;
}
.dis-name { font-size: 14px; font-weight: 600; }
.dis-desc { font-size: 13px; color: var(--text2); margin-bottom: 8px; }
.dis-meta { display: flex; justify-content: space-between; font-size: 12px; color: var(--text3); }

.dis-detail {
  display: none;
  margin-top: 12px;
  padding-top: 12px;
  border-top: 1px solid var(--border2);
}
.disruption-card.expanded .dis-detail { display: block; }

.dis-action {
  background: rgba(59,130,246,.07);
  border: 1px solid rgba(59,130,246,.2);
  border-radius: var(--r2);
  padding: 10px 12px;
  font-size: 13px;
  color: var(--text);
  margin-bottom: 8px;
}
.dis-action-label {
  font-size: 11px; font-weight: 700;
  text-transform: uppercase; letter-spacing: .5px;
  color: var(--blue); margin-bottom: 4px;
}

.affected-ships {
  display: flex; flex-wrap: wrap; gap: 6px;
  margin-top: 8px;
}
.affected-ship-tag {
  font-size: 11px; padding: 2px 10px;
  background: var(--bg2);
  border: 1px solid var(--border);
  border-radius: 10px;
  color: var(--text2);
  cursor: pointer;
  transition: border-color var(--t), color var(--t);
}
.affected-ship-tag:hover { border-color: var(--blue); color: var(--blue); }

/* ── Filter bar ──────────────────────────────────────────────── */
.filter-bar { display: flex; gap: 8px; margin-bottom: 16px; flex-wrap: wrap; }
.filter-btn {
  padding: 6px 14px; border-radius: var(--r2);
  border: 1px solid var(--border);
  background: var(--bg3); color: var(--text2);
  font-size: 13px;
  transition: all var(--t);
}
.filter-btn:hover { border-color: var(--blue); color: var(--blue); }
.filter-btn.active {
  background: rgba(59,130,246,.12);
  border-color: var(--blue); color: var(--blue);
  font-weight: 600;
}

/* ── Shipment list ───────────────────────────────────────────── */
.shipment-list { display: flex; flex-direction: column; gap: 12px; }

.shipment-card {
  background: var(--bg3);
  border: 1px solid var(--border);
  border-radius: var(--r);
  padding: 14px;
  cursor: pointer;
  transition: border-color var(--t), background var(--t);
}
.shipment-card:hover  { border-color: var(--blue); background: var(--bg3h); }
.shipment-card.expanded { border-color: var(--blue); }

.shp-header {
  display: flex; justify-content: space-between; align-items: flex-start;
  margin-bottom: 10px;
}
.shp-id    { font-size: 13px; font-weight: 700; color: var(--blue); font-family: monospace; }
.shp-route { font-size: 13px; font-weight: 500; margin-top: 2px; }
.shp-cargo { font-size: 12px; color: var(--text2); margin-top: 2px; }

.shp-badges { display: flex; flex-direction: column; align-items: flex-end; gap: 4px; }

/* Risk bar */
.risk-row {
  display: flex; align-items: center; gap: 8px;
  margin-bottom: 4px;
}
.risk-lbl { font-size: 11px; color: var(--text2); width: 62px; flex-shrink: 0; }
.risk-track {
  flex: 1; height: 6px;
  background: var(--border); border-radius: 3px; overflow: hidden;
}
.risk-fill { height: 100%; border-radius: 3px; }
.risk-fill.green  { background: var(--green); }
.risk-fill.amber  { background: var(--amber); }
.risk-fill.red    { background: var(--red); }
.risk-num { font-size: 12px; font-weight: 700; width: 28px; text-align: right; }

/* Classification badge */
.cls-badge {
  font-size: 10px; font-weight: 800;
  padding: 2px 8px; border-radius: 3px;
  text-transform: uppercase; letter-spacing: .8px;
}
.cls-low      { background: rgba(34,197,94,.12);  color: var(--green);  border: 1px solid rgba(34,197,94,.3); }
.cls-medium   { background: rgba(245,158,11,.12); color: var(--amber);  border: 1px solid rgba(245,158,11,.3); }
.cls-high     { background: rgba(249,115,22,.12); color: var(--orange); border: 1px solid rgba(249,115,22,.3); }
.cls-critical { background: rgba(239,68,68,.12);  color: var(--red);    border: 1px solid rgba(239,68,68,.3); }

/* Expanded detail */
.shp-detail {
  display: none;
  margin-top: 12px; padding-top: 12px;
  border-top: 1px solid var(--border2);
}
.shipment-card.expanded .shp-detail { display: block; }

.detail-row {
  display: flex; justify-content: space-between;
  padding: 4px 0; font-size: 12px;
  border-bottom: 1px solid var(--border2);
}
.detail-row:last-of-type { border-bottom: none; }
.detail-key   { color: var(--text2); }
.detail-val   { font-weight: 500; }

/* Score breakdown */
.breakdown {
  margin: 12px 0;
  background: var(--bg2);
  border: 1px solid var(--border);
  border-radius: var(--r2);
  overflow: hidden;
}
.breakdown-title {
  display: flex; justify-content: space-between; align-items: center;
  padding: 8px 12px;
  background: rgba(59,130,246,.05);
  border-bottom: 1px solid var(--border);
  font-size: 11px; font-weight: 700;
  text-transform: uppercase; letter-spacing: .5px;
  color: var(--text2);
}

.factor {
  padding: 8px 12px;
  border-bottom: 1px solid var(--border2);
}
.factor:last-child { border-bottom: none; }

.factor-header {
  display: flex; align-items: center; gap: 6px;
  margin-bottom: 4px;
}
.factor-icon  { font-size: 13px; width: 18px; flex-shrink: 0; }
.factor-label { font-size: 12px; font-weight: 600; flex: 1; }
.factor-pts   { font-size: 12px; font-weight: 700; font-family: monospace; white-space: nowrap; }
.factor-max   { font-size: 10px; color: var(--text3); font-weight: 400; }

.factor-bar   { height: 4px; background: var(--border); border-radius: 2px; overflow: hidden; margin-bottom: 4px; }
.factor-fill  { height: 100%; border-radius: 2px; }

.factor-reason { font-size: 11px; color: var(--text2); }

/* Reroute block */
.reroute-block {
  background: rgba(59,130,246,.07);
  border: 1px solid rgba(59,130,246,.2);
  border-radius: var(--r2);
  padding: 12px;
  margin-top: 10px;
}
.reroute-title {
  font-size: 11px; font-weight: 700;
  text-transform: uppercase; letter-spacing: .5px;
  color: var(--blue); margin-bottom: 6px;
}
.reroute-desc { font-size: 12px; margin-bottom: 8px; }
.reroute-tags { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 10px; }
.reroute-tag {
  font-size: 11px; padding: 2px 8px;
  background: var(--bg2); border: 1px solid var(--border);
  border-radius: 10px; color: var(--text2);
}

/* ── Fleet layout ─────────────────────────────────────────────── */
.fleet-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}

.redeploy-item {
  padding: 12px;
  background: var(--bg2);
  border: 1px solid var(--border);
  border-radius: var(--r2);
  margin-bottom: 10px;
}
.redeploy-item:last-child { margin-bottom: 0; }

.redeploy-header {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 6px;
}
.redeploy-vehicle { font-size: 13px; font-weight: 700; font-family: monospace; }
.redeploy-desc    { font-size: 12px; color: var(--text2); margin-bottom: 6px; }
.redeploy-target  { font-size: 11px; color: var(--text3); }

.vehicle-row {
  display: flex; align-items: center; gap: 10px;
  padding: 8px 0;
  border-bottom: 1px solid var(--border2);
  font-size: 13px;
}
.vehicle-row:last-child { border-bottom: none; }
.vehicle-icon  { font-size: 18px; flex-shrink: 0; }
.vehicle-info  { flex: 1; }
.vehicle-id    { font-weight: 700; font-family: monospace; }
.vehicle-loc   { font-size: 11px; color: var(--text2); }
.vehicle-util-bar { width: 60px; }

.util-track { height: 4px; background: var(--border); border-radius: 2px; overflow: hidden; margin-bottom: 2px; }
.util-fill  { height: 100%; border-radius: 2px; }
.util-fill.high   { background: var(--green); }
.util-fill.medium { background: var(--amber); }
.util-fill.low    { background: var(--red); }
.util-text { font-size: 10px; color: var(--text3); text-align: right; }

.idle-tag {
  font-size: 10px; font-weight: 700;
  color: var(--amber); text-transform: uppercase;
  letter-spacing: .5px;
}

/* ── Cold-chain ──────────────────────────────────────────────── */
.excursion-alert {
  background: rgba(239,68,68,.08);
  border: 1px solid rgba(239,68,68,.3);
  border-radius: var(--r2);
  padding: 12px 16px;
  margin-bottom: 16px;
}
.excursion-alert-title {
  font-size: 13px; font-weight: 700;
  color: var(--red); margin-bottom: 6px;
}
.excursion-tags { display: flex; gap: 8px; flex-wrap: wrap; }
.excursion-tag {
  font-size: 11px; padding: 2px 10px;
  background: rgba(239,68,68,.12);
  border: 1px solid rgba(239,68,68,.25);
  border-radius: 10px; color: var(--red);
}

.coldchain-card {
  background: var(--bg3);
  border: 1px solid var(--border);
  border-radius: var(--r);
  padding: 16px;
  margin-bottom: 14px;
}
.coldchain-card.excursion { border-color: rgba(239,68,68,.4); }

.cc-header {
  display: flex; justify-content: space-between; align-items: flex-start;
  margin-bottom: 12px;
}
.cc-product { font-size: 14px; font-weight: 600; }
.cc-id      { font-size: 11px; color: var(--text3); font-family: monospace; }

.cc-temps {
  display: flex; gap: 20px;
  margin-bottom: 14px;
}
.cc-temp-val {
  font-size: 22px; font-weight: 700;
}
.cc-temp-val.normal   { color: var(--green); }
.cc-temp-val.warning  { color: var(--amber); }
.cc-temp-val.critical { color: var(--red); }
.cc-temp-lbl { font-size: 11px; color: var(--text2); }

/* Simple sparkline chart (SVG) */
.sparkline-wrap { margin-bottom: 12px; }
.sparkline-wrap svg { display: block; width: 100%; }

.sev-badge {
  font-size: 11px; font-weight: 700;
  padding: 3px 10px; border-radius: 10px;
  text-transform: uppercase;
}
.sev-critical { background: rgba(239,68,68,.15);  color: var(--red); }
.sev-moderate { background: rgba(249,115,22,.15); color: var(--orange); }
.sev-minor    { background: rgba(245,158,11,.15); color: var(--amber); }
.sev-ok       { background: rgba(34,197,94,.15);  color: var(--green); }

.cc-action-log { font-size: 11px; color: var(--text3); margin-top: 8px; }
.cc-log-entry  { color: var(--green); padding: 2px 0; }

/* ── Modal ────────────────────────────────────────────────────── */
.modal-overlay {
  position: fixed; inset: 0;
  background: rgba(0,0,0,.7);
  display: flex; align-items: center; justify-content: center;
  z-index: 1000; padding: 20px;
}
.modal-overlay.hidden { display: none; }

.modal-box {
  background: var(--bg3);
  border: 1px solid rgba(239,68,68,.4);
  border-radius: 10px;
  width: 100%; max-width: 640px;
  max-height: 90vh; overflow-y: auto;
  box-shadow: 0 0 50px rgba(239,68,68,.15), 0 20px 50px rgba(0,0,0,.5);
}

.modal-alert-bar {
  background: var(--red); color: #fff;
  font-size: 11px; font-weight: 800;
  text-transform: uppercase; letter-spacing: 1.5px;
  padding: 8px 20px; border-radius: 9px 9px 0 0;
  text-align: center;
}

.modal-body { padding: 20px; }
.modal-body h2 { font-size: 19px; font-weight: 700; margin-bottom: 4px; }
.modal-sub { font-size: 12px; color: var(--text2); margin-bottom: 16px; padding-bottom: 16px; border-bottom: 1px solid var(--border); }

.modal-stats {
  display: grid; grid-template-columns: repeat(4, 1fr);
  border: 1px solid var(--border); border-radius: var(--r2);
  overflow: hidden; margin-bottom: 16px;
}
.modal-stat {
  padding: 14px 10px; text-align: center;
  border-right: 1px solid var(--border);
}
.modal-stat:last-child { border-right: none; }

.modal-stat-val { font-size: 24px; font-weight: 800; }
.modal-stat-lbl { font-size: 10px; color: var(--text2); text-transform: uppercase; letter-spacing: .4px; margin-top: 2px; }
.modal-stat.red   .modal-stat-val { color: var(--red); }
.modal-stat.amber .modal-stat-val { color: var(--amber); }
.modal-stat.blue  .modal-stat-val { color: var(--blue); }
.modal-stat.green .modal-stat-val { color: var(--green); }

.modal-section { margin-bottom: 14px; }
.modal-section-title {
  font-size: 10px; font-weight: 700;
  text-transform: uppercase; letter-spacing: .8px;
  color: var(--text2); margin-bottom: 8px;
}
.modal-row {
  display: flex; align-items: flex-start; gap: 10px;
  padding: 6px 0; font-size: 13px;
  border-bottom: 1px solid var(--border2);
}
.modal-row:last-child { border-bottom: none; }

.mbadge {
  font-size: 10px; font-weight: 700; flex-shrink: 0;
  padding: 2px 7px; border-radius: 3px;
  text-transform: uppercase; margin-top: 2px;
}
.mbadge.red    { background: rgba(239,68,68,.15);  color: var(--red);    border: 1px solid rgba(239,68,68,.3); }
.mbadge.amber  { background: rgba(245,158,11,.15); color: var(--amber);  border: 1px solid rgba(245,158,11,.3); }
.mbadge.blue   { background: rgba(59,130,246,.15); color: var(--blue);   border: 1px solid rgba(59,130,246,.3); }
.mbadge.green  { background: rgba(34,197,94,.15);  color: var(--green);  border: 1px solid rgba(34,197,94,.3); }

.modal-actions {
  display: flex; gap: 8px; flex-wrap: wrap;
  padding-top: 14px; border-top: 1px solid var(--border);
}
.modal-btn {
  padding: 9px 16px; border-radius: var(--r2);
  border: 1px solid transparent;
  font-size: 13px; font-weight: 600; font-family: inherit;
  cursor: pointer; transition: all var(--t);
}
.modal-btn.primary  { background: var(--blue); color: #fff; border-color: var(--blue); }
.modal-btn.primary:hover { background: var(--blue2); }
.modal-btn.secondary { background: rgba(59,130,246,.1); color: var(--blue); border-color: rgba(59,130,246,.3); }
.modal-btn.secondary:hover { background: rgba(59,130,246,.2); }
.modal-btn.ghost { background: transparent; color: var(--text2); border-color: var(--border); }
.modal-btn.ghost:hover { background: var(--bg3); color: var(--text); }

/* ── Scrollbar ────────────────────────────────────────────────── */
::-webkit-scrollbar { width: 6px; height: 6px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }
::-webkit-scrollbar-thumb:hover { background: var(--text3); }

/* ── Section fade ─────────────────────────────────────────────── */
.section { display: none; opacity: 0; }
.section.active { display: block; animation: fadein .2s ease forwards; }
@keyframes fadein { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }

/* ── AI Assistant layout ─────────────────────────────────────── */
.assistant-layout {
  display: grid;
  grid-template-columns: 1fr 300px;
  gap: 16px;
  align-items: start;
}

.assistant-left  { display: flex; flex-direction: column; gap: 16px; }
.assistant-right { display: flex; flex-direction: column; gap: 16px; }

/* ── Situation summary ───────────────────────────────────────── */
.situation-summary-card { padding: 16px; }

.situation-pills {
  display: grid; grid-template-columns: repeat(4, 1fr);
  gap: 10px; margin-bottom: 12px;
}

.sit-pill {
  padding: 12px 10px; text-align: center;
  border-radius: var(--r2);
  border: 1px solid var(--border);
}
.sit-pill.red    { background: rgba(239,68,68,.06);  border-color: rgba(239,68,68,.25); }
.sit-pill.amber  { background: rgba(245,158,11,.06); border-color: rgba(245,158,11,.25); }
.sit-pill.teal   { background: rgba(20,184,166,.06); border-color: rgba(20,184,166,.25); }
.sit-pill.purple { background: rgba(168,85,247,.06); border-color: rgba(168,85,247,.25); }

.sit-val { font-size: 28px; font-weight: 800; line-height: 1; }
.sit-pill.red    .sit-val { color: var(--red); }
.sit-pill.amber  .sit-val { color: var(--amber); }
.sit-pill.teal   .sit-val { color: var(--teal); }
.sit-pill.purple .sit-val { color: var(--purple); }

.sit-lbl { font-size: 10px; color: var(--text2); margin-top: 4px; text-transform: uppercase; letter-spacing: .3px; }
.sit-text { font-size: 13px; color: var(--text2); line-height: 1.6; }

/* ── Chat card ───────────────────────────────────────────────── */
.chat-card { padding: 16px; display: flex; flex-direction: column; }

.chat-messages {
  min-height: 240px; max-height: 420px;
  overflow-y: auto;
  display: flex; flex-direction: column; gap: 12px;
  padding: 4px 0 8px;
  margin-bottom: 10px;
}

.chat-bubble {
  max-width: 88%;
  padding: 10px 14px;
  border-radius: var(--r);
  font-size: 13px; line-height: 1.65;
}

.chat-bubble.user {
  align-self: flex-end;
  background: rgba(59,130,246,.15);
  border: 1px solid rgba(59,130,246,.3);
  color: var(--text);
}

.chat-bubble.assistant {
  align-self: flex-start;
  background: var(--bg2);
  border: 1px solid var(--border);
  color: var(--text);
}

.chat-content { margin-bottom: 8px; }

.copy-btn {
  background: none; border: none;
  color: var(--text3); font-size: 11px;
  padding: 0; cursor: pointer;
  transition: color var(--t);
}
.copy-btn:hover { color: var(--blue); }

/* ── Typing indicator ────────────────────────────────────────── */
.typing-indicator {
  display: flex; align-items: center; gap: 4px;
  padding: 12px 16px;
}
.typing-indicator span {
  width: 6px; height: 6px; border-radius: 50%;
  background: var(--text3);
  animation: typebounce 1.2s infinite;
}
.typing-indicator span:nth-child(2) { animation-delay: .2s; }
.typing-indicator span:nth-child(3) { animation-delay: .4s; }
@keyframes typebounce {
  0%,60%,100% { transform: translateY(0); opacity: .5; }
  30%         { transform: translateY(-6px); opacity: 1; }
}

/* ── Quick actions ───────────────────────────────────────────── */
.quick-actions {
  display: flex; flex-wrap: wrap; gap: 6px;
  padding-bottom: 10px;
  border-bottom: 1px solid var(--border2);
  margin-bottom: 10px;
}

.qa-btn {
  padding: 5px 11px;
  border-radius: 14px;
  border: 1px solid var(--border);
  background: var(--bg2);
  color: var(--text2); font-size: 12px;
  transition: all var(--t);
  white-space: nowrap;
}
.qa-btn:hover { border-color: var(--blue); color: var(--blue); background: rgba(59,130,246,.06); }

/* ── Chat input ──────────────────────────────────────────────── */
.chat-input-row {
  display: flex; gap: 8px;
}

.chat-input {
  flex: 1;
  padding: 9px 12px;
  border-radius: var(--r2);
  border: 1px solid var(--border);
  background: var(--bg2);
  color: var(--text);
  font-family: inherit; font-size: 13px;
  outline: none;
  transition: border-color var(--t);
}
.chat-input:focus { border-color: var(--blue); }
.chat-input::placeholder { color: var(--text3); }

.chat-send { flex-shrink: 0; }

/* ── Suggested actions ───────────────────────────────────────── */
.sug-action {
  display: flex; align-items: center; gap: 10px;
  padding: 9px;
  border-radius: var(--r2);
  border: 1px solid var(--border);
  background: var(--bg2);
  cursor: pointer;
  margin-bottom: 8px;
  transition: border-color var(--t), background var(--t);
  font-size: 12px;
}
.sug-action:last-child { margin-bottom: 0; }
.sug-action:hover { border-color: var(--blue); background: var(--bg3h); }
.sug-action.urgent { border-color: rgba(239,68,68,.3); }
.sug-action.urgent:hover { border-color: var(--red); background: rgba(239,68,68,.05); }

.sug-icon { font-size: 16px; flex-shrink: 0; width: 22px; text-align: center; }
.sug-text { flex: 1; }
.sug-main { font-weight: 500; }
.sug-sub  { font-size: 11px; color: var(--text2); margin-top: 1px; }

/* ── AI activity log ─────────────────────────────────────────── */
.ai-log-item {
  display: flex; align-items: flex-start; gap: 8px;
  padding: 7px 0;
  border-bottom: 1px solid var(--border2);
  font-size: 12px;
}
.ai-log-item:last-child { border-bottom: none; }

/* ── Help FAB ────────────────────────────────────────────────── */
.help-fab {
  position: fixed; bottom: 24px; right: 24px;
  width: 42px; height: 42px;
  border-radius: 50%;
  background: var(--blue2);
  border: 2px solid rgba(59,130,246,.5);
  color: #fff;
  font-size: 18px; font-weight: 700;
  z-index: 500;
  transition: transform var(--t), background var(--t);
  box-shadow: 0 4px 16px rgba(0,0,0,.4);
}
.help-fab:hover { transform: scale(1.1); background: var(--blue); }

/* ── Help modal steps ────────────────────────────────────────── */
.help-steps { display: flex; flex-direction: column; gap: 10px; }

.help-step {
  display: flex; align-items: flex-start; gap: 12px;
  padding: 10px 12px;
  border: 1px solid var(--border);
  border-radius: var(--r2);
  background: var(--bg2);
  font-size: 13px;
}

.help-step-highlight {
  border-color: rgba(239,68,68,.35);
  background: rgba(239,68,68,.05);
}

.help-num {
  min-width: 24px; height: 24px;
  border-radius: 50%;
  background: rgba(59,130,246,.2);
  border: 1px solid rgba(59,130,246,.4);
  color: var(--blue);
  font-size: 11px; font-weight: 800;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; margin-top: 1px;
}
.help-step-highlight .help-num {
  background: rgba(239,68,68,.2);
  border-color: rgba(239,68,68,.4);
  color: var(--red);
}

/* ── Responsive ───────────────────────────────────────────────── */
@media (max-width: 1100px) {
  .assistant-layout { grid-template-columns: 1fr; }
  .assistant-right  { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
}
@media (max-width: 900px) {
  .overview-bottom  { grid-template-columns: 1fr; }
  .fleet-layout     { grid-template-columns: 1fr; }
  .modal-stats      { grid-template-columns: repeat(2, 1fr); }
  .situation-pills  { grid-template-columns: repeat(2, 1fr); }
  .assistant-right  { grid-template-columns: 1fr; }
}
@media (max-width: 680px) {
  .sidebar { transform: translateX(-100%); }
  .sidebar.open { transform: translateX(0); }
  .main-wrapper { margin-left: 0; }
  .hamburger { display: block; }
  .kpi-grid { grid-template-columns: repeat(2, 1fr); }
}

.hidden { display: none !important; }


# app.js
/* ═══════════════════════════════════════════════════════════════
   ChainGuard AI — app.js
   No external dependencies. Open index.html directly in browser.
   ═══════════════════════════════════════════════════════════════ */
