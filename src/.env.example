/* ═══════════════════════════════════ STATE ═════════════════════ */

const STATE = {
  section: 'overview',
  shipmentFilter: 'all',
  assigned: new Set(),
  rerouted: new Set(),
  actionLogs: {},
  nh48Active: false
};

/* ═══════════════════════════════════ SCORING ENGINE ═══════════ */
/*
  scoreShipment(ship) → { score, classification, factors }

  Six additive factors, capped at 100.
  Every point traces to an explicit condition — no black box.

  Factor weights:
    Route Disruption  0–35
    Cargo Sensitivity 0–20
    Shipment Delay    0–20
    Cold-Chain Status 0–15
    Route Distance    0–5
    Alternate Routes  0–5
                     ────
                max = 100

  Classification:
    80–100 CRITICAL
    60–79  HIGH
    30–59  MEDIUM
    0–29   LOW
*/

function scoreShipment(ship) {
  const factors = [];

  /* ── 1. Route disruption (0–35) ── */
  const activeDis = DATA.disruptions.filter(d => d.affectedShipments.includes(ship.id));
  let disPts = 0, disReason = 'No active disruption on this route';
  if (activeDis.length) {
    const sev = { critical: 35, high: 25, medium: 15, low: 8 };
    const worst = activeDis.reduce((a, b) => (sev[a.severity] || 0) >= (sev[b.severity] || 0) ? a : b);
    disPts = sev[worst.severity] || 15;
    disReason = `${worst.icon} ${worst.name} (${worst.type}, ${worst.severity} severity)`;
  }
  factors.push({ label: 'Route Disruption',  icon: disPts > 0 ? '⚡' : '✓', pts: disPts, max: 35, reason: disReason });

  /* ── 2. Cargo sensitivity (0–20) ── */
  const c = (ship.cargo || '').toLowerCase();
  let cPts, cReason;
  if (c.includes('pharma') || c.includes('vaccine') || c.includes('medical')) {
    cPts = 20; cReason = 'Pharmaceutical/medical — regulatory and patient-safety risk';
  } else if (c.includes('electronics') || c.includes('cold')) {
    cPts = 15; cReason = 'High-value electronics or cold-sensitive — damage-prone';
  } else if (c.includes('food') || c.includes('produce') || c.includes('beverage')) {
    cPts = 12; cReason = 'Perishable — time-sensitive, spoilage risk';
  } else if (c.includes('chemical')) {
    cPts = 10; cReason = 'Chemical — hazmat compliance adds delay risk';
  } else if (c.includes('auto') || c.includes('industrial') || c.includes('equipment')) {
    cPts = 8;  cReason = 'Automotive/industrial — assembly-line dependency';
  } else {
    cPts = 4;  cReason = 'Standard consumer/retail — lower sensitivity';
  }
  factors.push({ label: 'Cargo Sensitivity', icon: '📦', pts: cPts, max: 20, reason: cReason });

  /* ── 3. Shipment delay (0–20) ── */
  const h = ship.delayHours || 0;
  let hPts, hReason;
  if (h === 0)  { hPts = 0;  hReason = 'No delay — on schedule'; }
  else if (h <= 2) { hPts = 5;  hReason = `${h}h delay — within SLA buffer`; }
  else if (h <= 6) { hPts = 10; hReason = `${h}h delay — approaching SLA threshold`; }
  else if (h <= 12){ hPts = 15; hReason = `${h}h delay — SLA breach likely without action`; }
  else             { hPts = 20; hReason = `${h}h delay — SLA breach confirmed`; }
  factors.push({ label: 'Shipment Delay',    icon: '⏱', pts: hPts, max: 20, reason: hReason });

  /* ── 4. Cold-chain temperature (0–15) ── */
  const td = DATA.tempReadings.find(t => t.shipmentId === ship.id);
  let tPts = 0, tReason = ship.coldChain ? 'Cold-chain active — no excursion detected' : 'Not a cold-chain shipment';
  if (td) {
    if (td.status === 'excursion') {
      const maxDev = Math.max(...td.readings.map(r => Math.max(r - td.safeMax, td.safeMin - r, 0)));
      if (maxDev > 5) { tPts = 15; tReason = `Critical excursion: +${maxDev.toFixed(1)}°C above safe limit — product integrity at risk`; }
      else if (maxDev > 2) { tPts = 10; tReason = `Moderate excursion: +${maxDev.toFixed(1)}°C deviation — investigate immediately`; }
      else            { tPts = 6;  tReason = `Minor excursion: +${maxDev.toFixed(1)}°C deviation — monitor closely`; }
    } else if (td.status === 'warning') {
      tPts = 4; tReason = `Temperature warning: ${td.currentTemp}${td.unit} — approaching safe limit`;
    } else {
      tReason = `In range: ${td.currentTemp}${td.unit} (safe ${td.safeMin}–${td.safeMax}${td.unit})`;
    }
  } else if (ship.coldChain) {
    tPts = 3; tReason = 'Cold-chain active — no live sensor data (monitoring gap)';
  }
  factors.push({ label: 'Cold-Chain Status', icon: '❄', pts: tPts, max: 15, reason: tReason });

  /* ── 5. Route distance (0–5) ── */
  const km = ship.distanceKm || 0;
  let dPts, dReason;
  if (km >= 2500) { dPts = 5; dReason = `Long-haul (${km.toLocaleString()} km) — high exposure window`; }
  else if (km >= 1500) { dPts = 3; dReason = `Mid-range (${km.toLocaleString()} km) — moderate exposure`; }
  else if (km >= 600)  { dPts = 2; dReason = `Regional (${km.toLocaleString()} km) — limited exposure`; }
  else                 { dPts = 1; dReason = `Short-haul (${km.toLocaleString()} km) — minimal exposure`; }
  factors.push({ label: 'Route Distance',    icon: '📍', pts: dPts, max: 5, reason: dReason });

  /* ── 6. Alternate routes (0–5) ── */
  const alts = ship.altRouteCount != null ? ship.altRouteCount : (ship.reroute ? 1 : 0);
  let aPts, aReason;
  if (alts === 0)     { aPts = 5; aReason = 'No alternate routes — disruption has no bypass option'; }
  else if (alts === 1){ aPts = 3; aReason = '1 alternate route — limited flexibility'; }
  else                { aPts = 0; aReason = `${alts} alternate routes — strong rerouting flexibility`; }
  factors.push({ label: 'Alternate Routes',  icon: '🔀', pts: aPts, max: 5, reason: aReason });

  const score = Math.min(100, Math.max(0, factors.reduce((s, f) => s + f.pts, 0)));
  const cls   = score >= 80 ? 'critical' : score >= 60 ? 'high' : score >= 30 ? 'medium' : 'low';
  const label = cls.toUpperCase();
  return { score, cls, label, factors };
}

/* ═══════════════════════════════════ NAVIGATION ═══════════════ */

function navigateTo(id) {
  document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
  const sec = document.getElementById('section-' + id);
  if (sec) sec.classList.add('active');
  const nav = document.querySelector('[data-section="' + id + '"]');
  if (nav) nav.classList.add('active');
  STATE.section = id;
  if (window.innerWidth <= 680) document.getElementById('sidebar').classList.remove('open');
}

/* ═══════════════════════════════════ RENDER: OVERVIEW ═════════ */

function renderKPIs() {
  const grid = document.getElementById('kpi-grid');
  if (!grid) return;
  const scores = DATA.shipments.map(scoreShipment);
  const critical   = scores.filter(r => r.score >= 80).length;
  const high       = scores.filter(r => r.score >= 60 && r.score < 80).length;
  const idle       = DATA.fleet.filter(v => v.status === 'idle').length;
  const excursions = DATA.tempReadings.filter(t => t.status === 'excursion').length;
  const onTime     = DATA.shipments.filter(s => s.status === 'on-time' || s.status === 'rerouted').length;
  const pct        = Math.round(onTime / DATA.shipments.length * 100);

  grid.innerHTML = [
    { lbl: 'Total Shipments',    val: DATA.shipments.length,        cls: 'blue',   d: '↑ 2 today',        dc: 'flat' },
    { lbl: 'Active Disruptions', val: DATA.disruptions.length,      cls: 'red',    d: '↑ 2 new',          dc: 'up' },
    { lbl: 'Critical Risk',      val: critical,                     cls: 'red',    d: `+${high} high`,    dc: 'up' },
    { lbl: 'On-Time Rate',       val: pct + '%',                    cls: 'green',  d: '↓ 8% vs yesterday',dc: 'up' },
    { lbl: 'Idle Fleet Assets',  val: idle,                         cls: 'purple', d: '$47.2K exposure',   dc: 'up' },
    { lbl: 'Temp Excursions',    val: excursions,                   cls: 'teal',   d: 'requires action',  dc: 'up' }
  ].map(k => `
    <div class="kpi-card ${k.cls}">
      <div class="kpi-value">${k.val}</div>
      <div class="kpi-label">${k.lbl}</div>
      <div class="kpi-delta ${k.dc}">${k.d}</div>
    </div>`).join('');
}

function renderAlerts() {
  const el = document.getElementById('alert-list');
  if (!el) return;
  el.innerHTML = DATA.alerts.map(a => `
    <li class="alert-item">
      <span class="alert-dot ${a.sev}"></span>
      <span class="alert-text">${a.msg}</span>
      <span class="alert-time">${a.time}</span>
    </li>`).join('');
}

function renderDisruptionSummary() {
  const el = document.getElementById('disruption-summary');
  if (!el) return;
  const c = { critical: 0, high: 0, medium: 0 };
  DATA.disruptions.forEach(d => { if (c[d.severity] !== undefined) c[d.severity]++; });
  const affected = DATA.disruptions.reduce((s, d) => s + d.affectedShipments.length, 0);
  el.innerHTML = [
    { lbl: 'Critical',        val: c.critical, cls: 'b-red' },
    { lbl: 'High Severity',   val: c.high,     cls: 'b-orange' },
    { lbl: 'Medium Severity', val: c.medium,   cls: 'b-amber' },
    { lbl: 'Affected Routes', val: affected,   cls: 'b-blue' }
  ].map(r => `
    <div class="dis-summary-row">
      <span>${r.lbl}</span>
      <span class="badge ${r.cls}">${r.val}</span>
    </div>`).join('');
}

/* ═══════════════════════════════════ RENDER: DISRUPTIONS ══════ */

function renderDisruptions() {
  const el = document.getElementById('disruption-list');
  if (!el) return;
  const severityBadge = { critical: 'b-red', high: 'b-orange', medium: 'b-amber', low: 'b-green' };

  el.innerHTML = DATA.disruptions.map(d => `
    <div class="disruption-card" id="dis-${d.id}" onclick="toggleDisruption('${d.id}')">
      <div class="dis-header">
        <span class="dis-name">${d.icon} ${d.name}</span>
        <span class="badge ${severityBadge[d.severity] || 'b-blue'}">${d.severity}</span>
      </div>
      <div class="dis-desc">${d.description}</div>
      <div class="dis-meta">
        <span>${d.type} · ${d.location}</span>
        <span>${d.affectedShipments.length} shipment(s) affected</span>
      </div>
      <div class="dis-detail">
        <div class="dis-action">
          <div class="dis-action-label">✦ Recommended Action</div>
          ${d.action}
        </div>
        <div class="affected-ships">
          ${d.affectedShipments.map(id => `
            <span class="affected-ship-tag" onclick="event.stopPropagation(); navigateTo('shipments'); highlightShipment('${id}')">${id}</span>
          `).join('')}
        </div>
      </div>
    </div>`).join('');
}

function toggleDisruption(id) {
  const el = document.getElementById('dis-' + id);
  if (el) el.classList.toggle('expanded');
}

/* ═══════════════════════════════════ RENDER: SHIPMENTS ════════ */

function scoreColor(score) {
  return score >= 80 ? 'red' : score >= 60 ? 'amber' : score >= 30 ? 'amber' : 'green';
}

function statusBadge(status) {
  const m = { disrupted: 'b-red', 'at-risk': 'b-orange', 'on-time': 'b-green', rerouted: 'b-blue' };
  return `<span class="badge ${m[status] || 'b-blue'}">${status}</span>`;
}

function renderShipments() {
  const el = document.getElementById('shipment-list');
  if (!el) return;

  const filter = STATE.shipmentFilter;
  let ships = DATA.shipments.filter(s => {
    const st = STATE.rerouted.has(s.id) ? 'rerouted' : s.status;
    return filter === 'all' || st === filter;
  });

  const scored = ships.map(s => ({ s, r: scoreShipment(s) })).sort((a, b) => b.r.score - a.r.score);

  if (!scored.length) {
    el.innerHTML = `<div style="color:var(--text2);padding:24px">No shipments match this filter.</div>`;
    return;
  }

  el.innerHTML = scored.map(({ s: ship, r }) => {
    const status = STATE.rerouted.has(ship.id) ? 'rerouted' : ship.status;
    const sc     = scoreColor(r.score);

    const factorRows = r.factors.map(f => {
      const pct = f.max > 0 ? Math.round(f.pts / f.max * 100) : 0;
      const col = f.pts === 0 ? 'var(--green)' : f.pts >= f.max * 0.75 ? 'var(--red)' : 'var(--amber)';
      return `
        <div class="factor">
          <div class="factor-header">
            <span class="factor-icon">${f.icon}</span>
            <span class="factor-label">${f.label}</span>
            <span class="factor-pts" style="color:${col}">+${f.pts}<span class="factor-max">/${f.max}</span></span>
          </div>
          <div class="factor-bar"><div class="factor-fill" style="width:${pct}%;background:${col}"></div></div>
          <div class="factor-reason">${f.reason}</div>
        </div>`;
    }).join('');

    const details = [
      { k: 'Carrier',    v: ship.carrier },
      { k: 'Cargo',      v: ship.cargo },
      { k: 'ETA',        v: ship.eta },
      { k: 'Cold-Chain', v: ship.coldChain ? '❄ Yes' : 'No' },
      ship.disruptionReason ? { k: 'Issue', v: ship.disruptionReason } : null
    ].filter(Boolean).map(r => `
      <div class="detail-row"><span class="detail-key">${r.k}</span><span class="detail-val">${r.v}</span></div>
    `).join('');

    const rerouteHtml = ship.reroute ? `
      <div class="reroute-block">
        <div class="reroute-title">✦ Recommended Alternate Route</div>
        <div class="reroute-desc">${ship.reroute.description}</div>
        <div class="reroute-tags">
          <span class="reroute-tag">⏱ ${ship.reroute.delaySaved}</span>
          <span class="reroute-tag">Confidence: ${ship.reroute.confidence}%</span>
          <span class="reroute-tag">${ship.reroute.altRoute}</span>
        </div>
        ${STATE.rerouted.has(ship.id)
          ? `<span class="badge b-blue">✓ Reroute Accepted</span>`
          : `<button class="btn btn-success" style="font-size:12px;padding:5px 12px" onclick="acceptReroute('${ship.id}',event)">Accept Reroute</button>`}
      </div>` : '';

    return `
      <div class="shipment-card" id="ship-${ship.id}" onclick="toggleShipment('${ship.id}')">
        <div class="shp-header">
          <div>
            <div class="shp-id">${ship.id}</div>
            <div class="shp-route">${ship.origin} → ${ship.destination}</div>
            <div class="shp-cargo">${ship.cargo}${ship.coldChain ? ' ❄' : ''}</div>
          </div>
          <div class="shp-badges">
            ${statusBadge(status)}
            <span class="cls-badge cls-${r.cls}">${r.label}</span>
          </div>
        </div>
        <div class="risk-row">
          <span class="risk-lbl">Risk Score</span>
          <div class="risk-track"><div class="risk-fill ${sc}" style="width:${r.score}%"></div></div>
          <span class="risk-num" style="color:var(--${sc === 'red' ? 'red' : sc === 'amber' ? 'amber' : 'green'})">${r.score}</span>
        </div>
        <div class="shp-detail">
          ${details}
          <div class="breakdown">
            <div class="breakdown-title">
              <span>Risk Score Breakdown</span>
              <span class="cls-badge cls-${r.cls}" style="font-size:11px">${r.score}/100 — ${r.label}</span>
            </div>
            ${factorRows}
          </div>
          ${rerouteHtml}
        </div>
      </div>`;
  }).join('');
}

function toggleShipment(id) {
  const el = document.getElementById('ship-' + id);
  if (el) el.classList.toggle('expanded');
}

function highlightShipment(id) {
  setTimeout(() => {
    STATE.shipmentFilter = 'all';
    document.querySelectorAll('.filter-btn').forEach(b => {
      b.classList.toggle('active', b.dataset.filter === 'all');
    });
    renderShipments();
    setTimeout(() => {
      const el = document.getElementById('ship-' + id);
      if (el) { el.classList.add('expanded'); el.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
    }, 80);
  }, 50);
}

function acceptReroute(id, e) {
  e.stopPropagation();
  STATE.rerouted.add(id);
  renderShipments();
  updateBadges();
  pushAlert({ sev: 'blue', msg: `REROUTED: ${id} accepted alternate route. Monitoring updated.`, time: 'just now' });
}

/* ═══════════════════════════════════ RENDER: FLEET ════════════ */

function renderFleet() {
  renderRedeployments();
  renderVehicles();
}

function renderRedeployments() {
  const el = document.getElementById('redeployment-list');
  if (!el) return;
  el.innerHTML = DATA.redeployments.map(op => {
    const done = STATE.assigned.has(op.vehicleId);
    return `
      <div class="redeploy-item">
        <div class="redeploy-header">
          <span class="redeploy-vehicle">${op.vehicleId}</span>
          ${done
            ? `<span class="badge b-green">✓ Assigned</span>`
            : `<button class="btn btn-success" style="font-size:12px;padding:4px 10px" onclick="assignVehicle('${op.vehicleId}')">Assign</button>`}
        </div>
        <div class="redeploy-desc">${op.reason}</div>
        <div class="redeploy-target">Target: ${op.targetShipment}</div>
      </div>`;
  }).join('');
}

function renderVehicles() {
  const el = document.getElementById('vehicle-list');
  if (!el) return;
  const sorted = [...DATA.fleet].sort((a, b) => {
    const o = { idle: 0, maintenance: 1, active: 2 };
    return (o[a.status] || 3) - (o[b.status] || 3);
  });
  el.innerHTML = sorted.map(v => {
    const isAssigned = STATE.assigned.has(v.id);
    const status     = isAssigned ? 'active' : v.status;
    const util       = isAssigned ? 85 : v.util;
    const uCls       = util > 70 ? 'high' : util > 30 ? 'medium' : 'low';
    return `
      <div class="vehicle-row">
        <span class="vehicle-icon">${v.icon}</span>
        <div class="vehicle-info">
          <div class="vehicle-id">${v.id}</div>
          <div class="vehicle-loc">${v.type} · ${v.location}</div>
        </div>
        <div class="vehicle-util-bar">
          <div class="util-track"><div class="util-fill ${uCls}" style="width:${util}%"></div></div>
          <div class="util-text">${util}%</div>
        </div>
        ${status === 'idle' && !isAssigned ? `<span class="idle-tag">IDLE</span>` : ''}
        ${status === 'maintenance' ? `<span class="idle-tag" style="color:var(--text2)">MAINT</span>` : ''}
        ${isAssigned ? `<span style="font-size:10px;color:var(--green);font-weight:700">ACTIVE</span>` : ''}
      </div>`;
  }).join('');
}

function assignVehicle(id) {
  STATE.assigned.add(id);
  renderFleet();
  updateBadges();
  pushAlert({ sev: 'green', msg: `ASSIGNED: ${id} dispatched to cover disrupted route.`, time: 'just now' });
}

/* ═══════════════════════════════════ RENDER: COLD-CHAIN ═══════ */

function classifyExcursion(readings, safeMin, safeMax) {
  const excReadings = readings.filter(r => r < safeMin || r > safeMax);
  if (!excReadings.length) return null;
  const maxDev = Math.max(...readings.map(r => Math.max(r - safeMax, safeMin - r, 0)));
  const dur    = excReadings.length * 30; // assume 30-min intervals
  if (maxDev > 5 || dur > 60) return { label: 'Critical', cls: 'sev-critical' };
  if (maxDev > 2 || dur > 30) return { label: 'Moderate', cls: 'sev-moderate' };
  return { label: 'Minor', cls: 'sev-minor' };
}

function renderColdChain() {
  const banner = document.getElementById('excursion-banner');
  const list   = document.getElementById('coldchain-list');
  if (!list) return;

  const excursions = DATA.tempReadings.filter(t => t.status === 'excursion');
  if (banner) {
    if (excursions.length) {
      banner.className = 'excursion-alert';
      banner.innerHTML = `
        <div class="excursion-alert-title">🔴 ${excursions.length} Active Temperature Excursion${excursions.length > 1 ? 's' : ''} — Immediate Action Required</div>
        <div class="excursion-tags">
          ${excursions.map(e => `<span class="excursion-tag">${e.shipmentId}: ${e.currentTemp}${e.unit} (max ${e.safeMax}${e.unit})</span>`).join('')}
        </div>`;
    } else {
      banner.className = '';
      banner.innerHTML = '';
    }
  }

  list.innerHTML = DATA.tempReadings.map(t => {
    const sev = classifyExcursion(t.readings, t.safeMin, t.safeMax);
    const tCls = t.status === 'excursion' ? 'critical' : t.status === 'warning' ? 'warning' : 'normal';
    const logs = STATE.actionLogs[t.shipmentId] || [];
    const svg  = buildSparkline(t.readings, t.safeMin, t.safeMax);
    return `
      <div class="coldchain-card ${t.status === 'excursion' ? 'excursion' : ''}">
        <div class="cc-header">
          <div>
            <div class="cc-product">${t.product}</div>
            <div class="cc-id">${t.shipmentId}</div>
          </div>
          ${sev ? `<span class="sev-badge ${sev.cls}">${sev.label} Excursion</span>` : `<span class="sev-badge sev-ok">In Range</span>`}
        </div>
        <div class="cc-temps">
          <div>
            <div class="cc-temp-val ${tCls}">${t.currentTemp}${t.unit}</div>
            <div class="cc-temp-lbl">Current</div>
          </div>
          <div>
            <div class="cc-temp-val" style="color:var(--blue);font-size:16px">${t.safeMin}–${t.safeMax}${t.unit}</div>
            <div class="cc-temp-lbl">Safe Range</div>
          </div>
          <div>
            <div class="cc-temp-val" style="color:var(--text2);font-size:16px">${t.readings[0]}${t.unit}</div>
            <div class="cc-temp-lbl">Start</div>
          </div>
        </div>
        <div class="sparkline-wrap">${svg}</div>
        <div style="margin-bottom:8px">
          <button class="btn btn-blue" style="font-size:12px;padding:5px 12px" onclick="logAction('${t.shipmentId}')">Log Corrective Action</button>
        </div>
        <div class="cc-action-log" id="log-${t.shipmentId}">
          ${logs.map(l => `<div class="cc-log-entry">✓ ${l}</div>`).join('')}
        </div>
      </div>`;
  }).join('');
}

function buildSparkline(readings, safeMin, safeMax) {
  const W = 500, H = 80, pad = 8;
  const allVals = [...readings, safeMin, safeMax];
  const minV = Math.min(...allVals) - 1;
  const maxV = Math.max(...allVals) + 1;
  const xS = i  => pad + i * (W - 2 * pad) / (readings.length - 1);
  const yS = v  => H - pad - (v - minV) / (maxV - minV) * (H - 2 * pad);

  const yMax = yS(safeMax), yMin = yS(safeMin);
  const pts  = readings.map((v, i) => `${xS(i)},${yS(v)}`).join(' ');
  const dots = readings.map((v, i) => {
    const bad = v < safeMin || v > safeMax;
    return `<circle cx="${xS(i)}" cy="${yS(v)}" r="3.5" fill="${bad ? '#ef4444' : '#22c55e'}" />`;
  }).join('');

  return `<svg viewBox="0 0 ${W} ${H}" xmlns="http://www.w3.org/2000/svg">
    <rect x="${pad}" y="${yMax}" width="${W - 2*pad}" height="${yMin - yMax}" fill="rgba(59,130,246,0.07)" />
    <line x1="${pad}" y1="${yMax}" x2="${W-pad}" y2="${yMax}" stroke="#ef4444" stroke-width="1.5" stroke-dasharray="5,3" />
    <line x1="${pad}" y1="${yMin}" x2="${W-pad}" y2="${yMin}" stroke="#22c55e" stroke-width="1.5" stroke-dasharray="5,3" />
    <polyline points="${pts}" fill="none" stroke="#3b82f6" stroke-width="2" stroke-linejoin="round" />
    ${dots}
  </svg>`;
}

function logAction(shipmentId) {
  if (!STATE.actionLogs[shipmentId]) STATE.actionLogs[shipmentId] = [];
  const opts = [
    'Driver notified — check refrigeration unit',
    'Dispatch contacted — backup reefer en route',
    'Customer notified of potential delay',
    'Deviation logged in compliance system',
    'Route diverted to nearest cold-storage facility'
  ];
  const msg = opts[STATE.actionLogs[shipmentId].length % opts.length];
  STATE.actionLogs[shipmentId].push(`${new Date().toLocaleTimeString()} — ${msg}`);
  const logEl = document.getElementById('log-' + shipmentId);
  if (logEl) logEl.innerHTML = STATE.actionLogs[shipmentId].map(l => `<div class="cc-log-entry">✓ ${l}</div>`).join('');
}

/* ═══════════════════════════════════ NH-48 SIMULATION ════════ */

function simulateNH48Closure() {
  if (STATE.nh48Active) {
    navigateTo('disruptions');
    return;
  }
  STATE.nh48Active = true;

  /* 1. Add disruption */
  DATA.disruptions.unshift({
    id: 'DIS-NH48', icon: '🚧', type: 'Road Closure', severity: 'critical',
    name: 'NH-48 Road Closure — Waterville Valley',
    location: 'Waterville Valley, NH',
    description: 'Multi-vehicle accident blocking NH Route 48 in both directions at Waterville Valley. Complete closure — NH DOT estimates 4–6h to clear.',
    affectedShipments: ['SHP-NH01', 'SHP-NH02', 'SHP-NH03'],
    action: 'Reroute via I-93 N → I-89 N. Deploy TRK-013 (Concord NH) and TRK-014 (White River Jct VT) for relay coverage.'
  });

  /* 2. Update affected shipments */
  const nh48Reroutes = {
    'SHP-NH01': { description: 'Divert via I-93 N → I-89 N → VT-2 W, bypassing White Mountain NH-48 corridor.', delaySaved: 'Saves ~3.5h vs waiting', confidence: 92, altRoute: 'I-93 N → I-89 N → VT-2 W' },
    'SHP-NH02': { description: 'Reroute via US-302 W → I-91 N → I-90 W into Albany. Cold-chain relay at White River Jct.', delaySaved: 'Saves ~2h', confidence: 88, altRoute: 'US-302 W → I-91 N → I-90 W' },
    'SHP-NH03': { description: 'Use I-93 N → US-3 N → QC-35 N. Adds only 19 miles.', delaySaved: 'Near-zero delay', confidence: 95, altRoute: 'I-93 N → US-3 N → QC-35 N' }
  };
  DATA.shipments.forEach(s => {
    if (!s.nh48Route) return;
    s.status         = s.id === 'SHP-NH01' ? 'disrupted' : 'at-risk';
    s.delayHours     = s.id === 'SHP-NH01' ? 14 : s.id === 'SHP-NH02' ? 8 : 5;
    s.altRouteCount  = 1;
    s.disruptionReason = 'NH Route 48 closed — multi-vehicle accident at Waterville Valley';
    s.reroute        = nh48Reroutes[s.id];
  });

  /* 3. Alerts */
  pushAlert({ sev: 'red',   msg: '🚧 CRITICAL: NH-48 closed at Waterville Valley — SHP-NH01, SHP-NH02, SHP-NH03 affected!', time: 'just now' });
  pushAlert({ sev: 'amber', msg: '⚠ AT-RISK: SHP-NH02 cold-chain cargo — rerouting delay increases excursion risk.', time: 'just now' });
  pushAlert({ sev: 'blue',  msg: '🚚 FLEET: TRK-013 (Concord NH) and TRK-014 (White River Jct) ready for redeployment.', time: 'just now' });

  /* 4. Re-render all sections */
  renderAll();
  updateBadges();

  /* 5. Show modal */
  document.getElementById('nh48-modal').classList.remove('hidden');

  /* 6. Update button */
  const btn = document.getElementById('nh48-btn');
  if (btn) { btn.textContent = '🚧 NH-48 Active — View Disruptions'; btn.classList.add('fired'); }
}

function closeModal() {
  document.getElementById('nh48-modal').classList.add('hidden');
}

/* ═══════════════════════════════════ AI ASSISTANT ════════════ */

const AI_RESPONSES = {
  top_disruption: () => {
    const d = DATA.disruptions.find(x => x.severity === 'critical') || DATA.disruptions[0];
    const ships = d.affectedShipments.join(', ');
    return `<strong>Top Active Disruption: ${d.icon} ${d.name}</strong><br><br>
Severity: <span style="color:var(--red);font-weight:700">${d.severity.toUpperCase()}</span> · ${d.type} · ${d.location}<br><br>
${d.description}<br><br>
<strong>Affected shipments:</strong> ${ships}<br><br>
<strong>Recommended action:</strong> ${d.action}<br><br>
This event is currently the highest-priority item in your operations queue. Immediate rerouting decisions will minimize downstream delays.`;
  },

  rerouting: () => {
    const atRisk = DATA.shipments.filter(s => !STATE.rerouted.has(s.id) && (s.status === 'disrupted' || s.status === 'at-risk'));
    if (!atRisk.length) return `All disrupted shipments have already been rerouted. Current fleet coverage is nominal. No immediate rerouting actions required.`;
    const top = atRisk[0];
    const r = top.reroute;
    return `<strong>${atRisk.length} shipment${atRisk.length > 1 ? 's' : ''} currently need rerouting:</strong><br><br>
${atRisk.map(s => {
  const sc = scoreShipment(s);
  return `• <span style="color:var(--blue);font-family:monospace">${s.id}</span> — ${s.origin} → ${s.destination} · Risk: <strong>${sc.score}/100</strong> · ${s.disruptionReason || 'Route disruption active'}`;
}).join('<br>')}<br><br>
<strong>Priority action for ${top.id}:</strong> ${r ? r.description : 'Review alternate route options.'}<br>
${r ? `Alternate: ${r.altRoute} · ${r.delaySaved} · ${r.confidence}% confidence` : ''}<br><br>
Navigate to <strong>Shipment Risk</strong> to accept reroutes directly.`;
  },

  idle_assets: () => {
    const idle = DATA.fleet.filter(v => v.status === 'idle' && !STATE.assigned.has(v.id));
    if (!idle.length) return `All fleet assets are currently active or assigned. Utilization is at optimal levels.`;
    const opps = DATA.redeployments.filter(r => !STATE.assigned.has(r.vehicleId));
    return `<strong>${idle.length} idle fleet asset${idle.length > 1 ? 's' : ''} identified for redeployment:</strong><br><br>
${idle.map(v => `• <span style="color:var(--amber);font-family:monospace">${v.id}</span> — ${v.type} · ${v.location}`).join('<br>')}<br><br>
${opps.length ? `<strong>Top redeployment opportunities:</strong><br>${opps.slice(0,3).map(o => `• ${o.vehicleId} → ${o.targetShipment}: ${o.reason}`).join('<br>')}` : ''}<br><br>
Total idle capacity represents <strong>$47,200 in potential recovery value</strong>. Navigate to <strong>Fleet Intelligence</strong> to assign assets.`;
  },

  cold_chain: () => {
    const exc = DATA.tempReadings.filter(t => t.status === 'excursion');
    const warn = DATA.tempReadings.filter(t => t.status === 'warning');
    if (!exc.length && !warn.length) return `All cold-chain shipments are currently within safe temperature ranges. No excursions detected. Monitoring continues.`;
    return `<strong>${exc.length} active temperature excursion${exc.length !== 1 ? 's' : ''} require immediate attention:</strong><br><br>
${exc.map(t => {
  const sev = classifyExcursion(t.readings, t.safeMin, t.safeMax);
  return `• <span style="color:var(--red);font-family:monospace">${t.shipmentId}</span> — ${t.product} · Current: <strong>${t.currentTemp}${t.unit}</strong> (safe max: ${t.safeMax}${t.unit}) · Severity: ${sev ? sev.label : 'Active'}`;
}).join('<br>')}
${warn.length ? `<br><strong>${warn.length} warning${warn.length !== 1 ? 's' : ''} approaching safe limits:</strong><br>${warn.map(t => `• ${t.shipmentId}: ${t.currentTemp}${t.unit} (safe max ${t.safeMax}${t.unit})`).join('<br>')}` : ''}<br><br>
Immediate corrective actions: verify refrigeration unit integrity, contact driver, and log compliance deviations. Navigate to <strong>Cold-Chain Monitor</strong> to log actions.`;
  },

  situation_report: () => {
    const atRisk  = DATA.shipments.filter(s => !STATE.rerouted.has(s.id) && (s.status === 'disrupted' || s.status === 'at-risk')).length;
    const reroutedN = STATE.rerouted.size + DATA.shipments.filter(s => s.status === 'rerouted').length;
    const idle    = DATA.fleet.filter(v => v.status === 'idle' && !STATE.assigned.has(v.id)).length;
    const exc     = DATA.tempReadings.filter(t => t.status === 'excursion').length;
    const onTime  = DATA.shipments.filter(s => s.status === 'on-time' || STATE.rerouted.has(s.id) || s.status === 'rerouted').length;
    const pct     = Math.round(onTime / DATA.shipments.length * 100);
    return `<strong>Full Situation Report — ${new Date().toLocaleTimeString()}</strong><br><br>
<strong>Operations Status:</strong><br>
• ${DATA.shipments.length} total shipments tracked · ${pct}% on-time performance<br>
• ${atRisk} shipment${atRisk !== 1 ? 's' : ''} currently disrupted or at-risk<br>
• ${reroutedN} shipment${reroutedN !== 1 ? 's' : ''} successfully rerouted<br><br>
<strong>Active Disruptions (${DATA.disruptions.length}):</strong><br>
${DATA.disruptions.map(d => `• ${d.icon} ${d.name} — ${d.severity.toUpperCase()} · ${d.affectedShipments.length} shipment(s) affected`).join('<br>')}<br><br>
<strong>Fleet Status:</strong><br>
• ${DATA.fleet.filter(v => v.status === 'active' || STATE.assigned.has(v.id)).length} active · ${idle} idle · ${DATA.fleet.filter(v => v.status === 'maintenance').length} in maintenance<br>
• ${STATE.assigned.size} asset${STATE.assigned.size !== 1 ? 's' : ''} deployed via this session<br><br>
<strong>Cold-Chain Alerts:</strong><br>
• ${exc} active excursion${exc !== 1 ? 's' : ''} · ${DATA.tempReadings.filter(t => t.status === 'warning').length} warning${DATA.tempReadings.filter(t => t.status === 'warning').length !== 1 ? 's' : ''} · ${DATA.tempReadings.filter(t => t.status === 'normal').length} nominal<br><br>
<strong>Recommended Priorities:</strong><br>
1. Address critical temperature excursion on SHP-5512 (pharmaceuticals — patient safety risk)<br>
2. Accept reroutes for all disrupted shipments to minimize SLA breaches<br>
3. Deploy TRK-001 and TRK-003 (idle reefer trucks) to cover rerouted cold-chain lanes`;
  },

  eta_risk: () => {
    const delayed = DATA.shipments.filter(s => s.delayHours > 0).sort((a, b) => b.delayHours - a.delayHours);
    if (!delayed.length) return `All shipments are currently running on schedule. No ETA risk detected.`;
    return `<strong>ETA Risk Analysis — ${delayed.length} shipment${delayed.length !== 1 ? 's' : ''} with delays:</strong><br><br>
${delayed.map(s => {
  const r = scoreShipment(s);
  return `• <span style="font-family:monospace;color:var(--blue)">${s.id}</span> — +${s.delayHours}h delay · Risk ${r.score}/100 · ${s.cargo}`;
}).join('<br>')}<br><br>
<strong>Highest impact:</strong> ${delayed[0].id} with +${delayed[0].delayHours}h delay. ${delayed[0].reroute ? `Alternate route available via ${delayed[0].reroute.altRoute}.` : 'No alternate route on file — escalate to operations team.'}`;
  },

  disruption_summary: () => {
    const bySev = { critical: [], high: [], medium: [], low: [] };
    DATA.disruptions.forEach(d => { (bySev[d.severity] || (bySev[d.severity] = [])).push(d); });
    return `<strong>All Active Disruptions by Severity:</strong><br><br>
${Object.entries(bySev).filter(([, arr]) => arr.length).map(([sev, arr]) => `
<strong style="text-transform:uppercase">${sev}:</strong><br>
${arr.map(d => `• ${d.icon} <strong>${d.name}</strong> — ${d.location}<br>  ${d.affectedShipments.length} shipment(s) · Action: ${d.action}`).join('<br><br>')}
`).join('<br>')}<br>
Navigate to <strong>Disruption Monitor</strong> to view each event on the map and expand recommended actions.`;
  },

  fleet_utilization: () => {
    const types = {};
    DATA.fleet.forEach(v => {
      if (!types[v.type]) types[v.type] = { active: 0, idle: 0, maint: 0 };
      if (v.status === 'active' || STATE.assigned.has(v.id)) types[v.type].active++;
      else if (v.status === 'idle') types[v.type].idle++;
      else types[v.type].maint++;
    });
    return `<strong>Fleet Utilization Breakdown:</strong><br><br>
${Object.entries(types).map(([type, t]) => {
  const total = t.active + t.idle + t.maint;
  const pct = Math.round(t.active / total * 100);
  return `• <strong>${type}</strong>: ${t.active}/${total} active (${pct}% utilization) · ${t.idle} idle · ${t.maint} maintenance`;
}).join('<br>')}<br><br>
Overall fleet utilization: <strong>${Math.round(DATA.fleet.filter(v => v.status === 'active').length / DATA.fleet.length * 100)}%</strong>. Idle assets represent a redeployment opportunity worth <strong>$47,200</strong> in recovered capacity value.`;
  },

  help: () => `<strong>I can answer questions about:</strong><br><br>
• <em>"What's the top disruption?"</em> — most critical active disruption<br>
• <em>"Which shipments need rerouting?"</em> — at-risk shipment list with recommendations<br>
• <em>"Find idle assets"</em> — idle fleet vehicles available for redeployment<br>
• <em>"Cold chain alerts"</em> — temperature excursion status<br>
• <em>"Situation report"</em> — full operations summary<br>
• <em>"ETA risk"</em> or <em>"delays"</em> — shipments with delay exposure<br>
• <em>"All disruptions"</em> — complete disruption breakdown by severity<br>
• <em>"Fleet utilization"</em> — utilization rates by vehicle type<br><br>
You can also click the quick-action buttons above the input field for instant answers.`,

  unknown: (q) => `I couldn't find a specific match for <em>"${q}"</em>. Try asking about: disruptions, rerouting, idle assets, cold chain, ETA risk, fleet utilization, or ask for a full situation report. Click a quick-action button below for instant context-aware responses.`
};

const QUICK_ACTIONS = [
  { label: '★ Situation Report',          key: 'situation_report' },
  { label: '⚡ Top Disruption',            key: 'top_disruption' },
  { label: '📦 Rerouting Needed',          key: 'rerouting' },
  { label: '🚛 Find Idle Assets',          key: 'idle_assets' },
  { label: '❄ Cold-Chain Alerts',         key: 'cold_chain' },
  { label: '⏱ ETA Risk',                  key: 'eta_risk' },
  { label: '🗺 All Disruptions',           key: 'disruption_summary' },
  { label: '📊 Fleet Utilization',         key: 'fleet_utilization' }
];

function matchQuery(text) {
  const t = text.toLowerCase();
  if (t.match(/situation|report|summary|overview|status|full/))           return 'situation_report';
  if (t.match(/top.disruption|biggest|worst|critical|hurricane|storm/))   return 'top_disruption';
  if (t.match(/rerout|rerouting|alt(ernate)?|redirect|divert/))           return 'rerouting';
  if (t.match(/idle|redeploy|available|unused|free|asset/))               return 'idle_assets';
  if (t.match(/cold.chain|temp|excursion|pharma|reefer|cool|refriger/))   return 'cold_chain';
  if (t.match(/eta|delay|late|behind|schedule|time/))                     return 'eta_risk';
  if (t.match(/all disruption|every disruption|list disruption|severity/))return 'disruption_summary';
  if (t.match(/fleet|utiliz|truck|van|vehicle/))                          return 'fleet_utilization';
  if (t.match(/help|what can|how|guide/))                                 return 'help';
  return null;
}

function renderAssistant() {
  renderSituationSummary();
  renderQuickActions();
  renderSuggestedActions();
  renderAiActivityLog();
  if (!document.getElementById('chat-messages').children.length) {
    appendAiMessage(`Welcome to <strong>ChainGuard AI</strong>. I have full visibility into your supply chain operations right now.<br><br>There are currently <strong>${DATA.disruptions.length} active disruptions</strong>, <strong>${DATA.shipments.filter(s => s.status === 'disrupted' || s.status === 'at-risk').length} shipments</strong> at risk, and <strong>${DATA.tempReadings.filter(t => t.status === 'excursion').length} temperature excursions</strong> requiring attention.<br><br>Ask me anything or use the quick-action buttons below.`);
  }
}

function renderSituationSummary() {
  const el = document.getElementById('situation-summary');
  if (!el) return;
  const atRisk = DATA.shipments.filter(s => s.status === 'disrupted' || s.status === 'at-risk').length;
  const exc    = DATA.tempReadings.filter(t => t.status === 'excursion').length;
  const idle   = DATA.fleet.filter(v => v.status === 'idle' && !STATE.assigned.has(v.id)).length;
  el.innerHTML = `
    <div class="card-header"><h3>Operations Snapshot</h3><span style="font-size:11px;color:var(--text2)">${new Date().toLocaleTimeString()}</span></div>
    <div class="situation-pills">
      <div class="sit-pill red">
        <div class="sit-val">${atRisk}</div>
        <div class="sit-lbl">Shipments at Risk</div>
      </div>
      <div class="sit-pill amber">
        <div class="sit-val">${DATA.disruptions.length}</div>
        <div class="sit-lbl">Active Disruptions</div>
      </div>
      <div class="sit-pill teal">
        <div class="sit-val">${exc}</div>
        <div class="sit-lbl">Temp Excursions</div>
      </div>
      <div class="sit-pill purple">
        <div class="sit-val">${idle}</div>
        <div class="sit-lbl">Idle Fleet Assets</div>
      </div>
    </div>
    <p class="sit-text">ChainGuard AI has identified <strong>${atRisk} shipment${atRisk !== 1 ? 's' : ''}</strong> exposed to active disruption events. ${exc > 0 ? `<span style="color:var(--red)"><strong>${exc} cold-chain excursion${exc !== 1 ? 's' : ''}</strong> require immediate corrective action.</span>` : 'Cold-chain status nominal.'} ${idle} idle fleet asset${idle !== 1 ? 's' : ''} available for emergency redeployment.</p>`;
}

function renderQuickActions() {
  const el = document.getElementById('quick-actions');
  if (!el) return;
  el.innerHTML = QUICK_ACTIONS.map(q =>
    `<button class="qa-btn" onclick="runQuickAction('${q.key}')">${q.label}</button>`
  ).join('');
}

function renderSuggestedActions() {
  const el = document.getElementById('suggested-actions-list');
  if (!el) return;
  const actions = [];
  DATA.shipments.filter(s => (s.status === 'disrupted' || s.status === 'at-risk') && s.reroute && !STATE.rerouted.has(s.id)).forEach(s => {
    actions.push({ icon: '📦', text: `Accept reroute for ${s.id}`, sub: s.reroute.altRoute, urgent: s.status === 'disrupted', cb: `navigateTo('shipments');highlightShipment('${s.id}')` });
  });
  DATA.tempReadings.filter(t => t.status === 'excursion').forEach(t => {
    actions.push({ icon: '❄', text: `Log corrective action: ${t.shipmentId}`, sub: `${t.currentTemp}${t.unit} — exceeds safe max`, urgent: true, cb: `navigateTo('coldchain')` });
  });
  DATA.redeployments.filter(r => !STATE.assigned.has(r.vehicleId)).slice(0,2).forEach(r => {
    actions.push({ icon: '🚛', text: `Deploy ${r.vehicleId}`, sub: `Cover ${r.targetShipment}`, urgent: false, cb: `navigateTo('fleet')` });
  });
  if (!actions.length) {
    el.innerHTML = `<div style="color:var(--text2);font-size:12px;padding:8px 0">No pending actions. Operations nominal.</div>`;
    return;
  }
  el.innerHTML = actions.map(a => `
    <div class="sug-action ${a.urgent ? 'urgent' : ''}" onclick="${a.cb}">
      <span class="sug-icon">${a.icon}</span>
      <div class="sug-text">
        <div class="sug-main">${a.text}</div>
        <div class="sug-sub">${a.sub}</div>
      </div>
      ${a.urgent ? `<span class="badge b-red" style="font-size:9px">URGENT</span>` : ''}
    </div>`).join('');
}

function renderAiActivityLog() {
  const el = document.getElementById('ai-activity-log');
  if (!el) return;
  const items = DATA.alerts.slice(0, 5);
  el.innerHTML = items.map(a => `
    <div class="ai-log-item">
      <span class="alert-dot ${a.sev}"></span>
      <span style="font-size:12px;flex:1">${a.msg}</span>
      <span class="alert-time">${a.time}</span>
    </div>`).join('');
}

function appendUserMessage(text) {
  const el = document.getElementById('chat-messages');
  if (!el) return;
  const div = document.createElement('div');
  div.className = 'chat-bubble user';
  div.textContent = text;
  el.appendChild(div);
  el.scrollTop = el.scrollHeight;
}

function appendAiMessage(html, animate) {
  const el = document.getElementById('chat-messages');
  if (!el) return;

  if (animate) {
    const typing = document.createElement('div');
    typing.className = 'chat-bubble assistant typing-indicator';
    typing.innerHTML = '<span></span><span></span><span></span>';
    el.appendChild(typing);
    el.scrollTop = el.scrollHeight;

    setTimeout(() => {
      el.removeChild(typing);
      insertAssistantBubble(el, html);
    }, 900);
  } else {
    insertAssistantBubble(el, html);
  }
}

function insertAssistantBubble(container, html) {
  const div = document.createElement('div');
  div.className = 'chat-bubble assistant';
  div.innerHTML = `<div class="chat-content">${html}</div>
    <button class="copy-btn" onclick="copyMessage(this)" title="Copy response">⎘ Copy</button>`;
  container.appendChild(div);
  container.scrollTop = container.scrollHeight;
}

function copyMessage(btn) {
  const text = btn.previousElementSibling.innerText;
  navigator.clipboard.writeText(text).then(() => {
    btn.textContent = '✓ Copied';
    setTimeout(() => { btn.textContent = '⎘ Copy'; }, 1800);
  }).catch(() => {
    btn.textContent = '✓ Copied';
    setTimeout(() => { btn.textContent = '⎘ Copy'; }, 1800);
  });
}

function sendChatMessage() {
  const input = document.getElementById('chat-input');
  if (!input) return;
  const text = input.value.trim();
  if (!text) return;
  input.value = '';
  appendUserMessage(text);
  const key = matchQuery(text);
  const responseFn = key ? AI_RESPONSES[key] : null;
  const html = responseFn ? responseFn() : AI_RESPONSES.unknown(text);
  appendAiMessage(html, true);
}

function runQuickAction(key) {
  const qa = QUICK_ACTIONS.find(q => q.key === key);
  const label = qa ? qa.label.replace(/^[^\w]+/, '').trim() : key;
  appendUserMessage(label);
  const responseFn = AI_RESPONSES[key];
  const html = responseFn ? responseFn() : AI_RESPONSES.unknown(label);
  appendAiMessage(html, true);
}

/* ═══════════════════════════════════ HELPERS ══════════════════ */

function pushAlert(a) {
  DATA.alerts.unshift(a);
  if (DATA.alerts.length > 12) DATA.alerts.pop();
  renderAlerts();
}

function updateBadges() {
  const disBadge  = document.getElementById('badge-disruptions');
  const shipBadge = document.getElementById('badge-shipments');
  const fleetBadge = document.getElementById('badge-fleet');
  if (disBadge) disBadge.textContent = DATA.disruptions.length;
  if (shipBadge) {
    const n = DATA.shipments.filter(s =>
      !STATE.rerouted.has(s.id) && (s.status === 'disrupted' || s.status === 'at-risk')
    ).length;
    shipBadge.textContent = n;
  }
  if (fleetBadge) {
    fleetBadge.textContent = DATA.fleet.filter(v => v.status === 'idle' && !STATE.assigned.has(v.id)).length;
  }
}

function renderAll() {
  renderKPIs();
  renderAlerts();
  renderDisruptionSummary();
  renderDisruptions();
  renderShipments();
  renderFleet();
  renderColdChain();
  renderAssistant();
}

/* ═══════════════════════════════════ INIT ═════════════════════ */

function init() {
  /* Sidebar nav */
  document.querySelectorAll('.nav-item').forEach(el => {
    el.addEventListener('click', e => {
      e.preventDefault();
      const s = el.dataset.section;
      if (s) navigateTo(s);
    });
  });

  /* Filter buttons */
  document.querySelectorAll('.filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      STATE.shipmentFilter = btn.dataset.filter;
      renderShipments();
    });
  });

  /* Hamburger */
  document.getElementById('hamburger').addEventListener('click', () => {
    document.getElementById('sidebar').classList.toggle('open');
  });

  /* Chat send */
  const sendBtn = document.getElementById('chat-send');
  const chatIn  = document.getElementById('chat-input');
  if (sendBtn) sendBtn.addEventListener('click', sendChatMessage);
  if (chatIn)  chatIn.addEventListener('keydown', e => { if (e.key === 'Enter') sendChatMessage(); });

  /* Clock */
  function tick() {
    const el = document.getElementById('live-clock');
    if (el) el.textContent = new Date().toLocaleString('en-US', {
      weekday: 'short', month: 'short', day: 'numeric',
      hour: '2-digit', minute: '2-digit', second: '2-digit'
    });
  }
  tick();
  setInterval(tick, 1000);

  /* Initial render */
  renderAll();
  updateBadges();
}

document.addEventListener('DOMContentLoaded', init);


